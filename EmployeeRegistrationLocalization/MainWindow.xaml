<Window x:Class="Localization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Localization"
        mc:Ignorable="d"
        Title="Employee Registration"
        Height="750" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F8">

    <Grid>
        <Border Width="560"
                Padding="30"
                Background="White"
                CornerRadius="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>
                <TextBlock Text="EMPLOYEE REGISTRATION"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#C2185B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,15">
                    <TextBlock Text="Language:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="LanguageComboBox"
                              Width="130"
                              SelectedIndex="0"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="தமிழ்"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="NameLabel"
                           Text="Employee Name"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="NameTextBox"
                         Height="36"
                         Padding="8"
                         Margin="0,5,0,12"/>

                <TextBlock x:Name="EmailLabel"
                           Text="Email Address"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="EmailTextBox"
                         Height="36"
                         Padding="8"
                         Margin="0,5,0,12"/>

                <TextBlock x:Name="DepartmentLabel"
                           Text="Department"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="DepartmentComboBox"
                          Height="36"
                          Padding="6"
                          Margin="0,5,0,12">
                    <ComboBoxItem Content="IT"/>
                    <ComboBoxItem Content="HR"/>
                    <ComboBoxItem Content="Finance"/>
                    <ComboBoxItem Content="Marketing"/>
                </ComboBox>

                <TextBlock x:Name="GenderLabel"
                           Text="Gender"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="GenderComboBox"
                          Height="36"
                          Padding="6"
                          Margin="0,5,0,12">
                    <ComboBoxItem Content="Male"/>
                    <ComboBoxItem Content="Female"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <TextBlock x:Name="DobLabel"
                           Text="Date of Birth"
                           FontWeight="SemiBold"/>
                <DatePicker x:Name="DobPicker"
                            Height="36"
                            Margin="0,5,0,20"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="RegisterButton"
                            Content="Register"
                            Width="145"
                            Height="42"
                            Margin="5"
                            Background="#D81B60"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="RegisterButton_Click"/>

                    <Button x:Name="ResetButton"
                            Content="Reset"
                            Width="120"
                            Height="42"
                            Margin="5"
                            Background="#F3D5E2"
                            Foreground="#880E4F"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="ResetButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

